# =====================================================
# PAYPORT GATEWAY - Environment Variables Template
# =====================================================
#
# Copy this file to `.env` (gitignored) and fill in real values, or set
# these directly in your deployment environment (server env vars,
# docker-compose secrets, systemd EnvironmentFile, CI/CD secret store).
#
# None of these have defaults in application.properties -- the app will
# refuse to start if a required one is missing.

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/gateway?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=

# --- JWT signing secret ---
# Controls authentication for all roles, including staff/admin. Generate a
# fresh, long, random value.
JWT_SECRET=

# --- EcoCash ---
ECOCASH_MERCHANT_CODE=
ECOCASH_MERCHANT_PIN=
ECOCASH_MERCHANT_NUMBER=
ECOCASH_TERMINAL_ID=
ECOCASH_USERNAME=
ECOCASH_PASSWORD=

# --- OneMoney ---
# base-url has a fallback default in application.properties -- override
# once confirmed as the correct production endpoint.
ONEMONEY_BASE_URL=
ONEMONEY_MERCHANT_NO=
ONEMONEY_ENCRYPT_KEY_ID=
ONEMONEY_PLATFORM_PUBLIC_KEY=
# Signs every request OneMoney receives as coming from PayPort. The most
# sensitive value in this file.
ONEMONEY_MERCHANT_PRIVATE_KEY=

# --- Omari ---
# base-url has a fallback default pointing at Omari's UAT environment --
# override with their production URL once available.
OMARI_BASE_URL=
OMARI_API_KEY=
OMARI_TEST_MSISDN=

# --- Econet Airtime (XML-RPC) ---
ECONET_ENDPOINT=
ECONET_PORT=
ECONET_ZWG_USERNAME=
ECONET_ZWG_PASSWORD=
ECONET_USD_USERNAME=
ECONET_USD_PASSWORD=

# --- NetOne ---
NETONE_ACCESS_CODE=
NETONE_ACCESS_PASSWORD=

# --- Africa's Talking (SMS) ---
# username has a fallback default of "sandbox" (test mode) -- override
# with your real account username to deliver SMS to customers.
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_SENDER_ID=

# --- Telecel ---
TELECEL_AGENT_CODE=
TELECEL_MPIN=
# ZWG agent account -- separate credentials, not issued yet. Fill in once
# Telecel provides them; leave blank until then.
TELECEL_ZWG_AGENT_CODE=
TELECEL_ZWG_MPIN=

# --- ZimSwitch ---
ZIMSWITCH_ENTITY_ID=
ZIMSWITCH_BEARER_TOKEN=

# --- e-Solutions (ZESA, TelOne, Bulawayo, ZOL, Nyaradzo, Moonlight) ---
# base-url has a fallback default pointing at e-Solutions' TEST
# environment -- override with their production URL once confirmed.
ESOLUTIONS_BASE_URL=
ESOLUTIONS_USERNAME=
ESOLUTIONS_PASSWORD=
ESOLUTIONS_VENDOR_NUMBER=
ESOLUTIONS_ACCOUNT_NUMBER=

# --- SMTP (staff password reset emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# =====================================================
# PSP
# =====================================================
# --- Field encryption (payout account numbers, partner secrets). REQUIRED. ---
# Generate each key with: openssl rand -base64 32
# Rotation: add a new id, switch ACTIVE to it, run the re-encrypt job, then retire the old id.
# In production, supply these from your secrets manager / HSM-backed KMS, never from a file.
PAYPORT_DATA_KEYS=
PAYPORT_DATA_KEY_ACTIVE=
PAYPORT_INDEX_KEY=

JPA_DDL_AUTO=update
PSP_TRUSTED_PROXIES=127.0.0.1
PSP_SETTLEMENT_CASH_USD=TRUST_USD_MAIN
PSP_SETTLEMENT_CASH_ZWG=TRUST_ZWG_MAIN
PSP_SETTLEMENT_REQUIRE_COVERAGE=false
PSP_SETTLEMENT_PROOF_DIR=/var/payport/uploads/settlement-proofs
PSP_TRUST_ACCOUNTS=TRUST_USD_MAIN,TRUST_ZWG_MAIN
# Never true in production: enables simulated bank/ID/bureau adapters.
PSP_SANDBOX=false
PSP_KYC_ID_VERIFIER=MANUAL
PSP_KYC_CREDIT_BUREAU=MANUAL
PSP_AML_FEEDS=false
PSP_OPS_EMAIL=
PSP_COMPLIANCE_EMAIL=
PSP_USSD_CALLBACK_TOKEN=
PSP_USSD_ALLOWED_IPS=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
