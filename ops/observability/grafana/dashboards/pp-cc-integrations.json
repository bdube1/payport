      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "100 * (1 - avg_over_time(probe_success{job=\"provider-connectivity\", module=\"icmp\"}[10m]))",
          "legendFormat": "{{name}}",
          "refId": "I"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
