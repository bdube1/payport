        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"payport-gateway\", level=~\"WARN|ERROR\"} |~ \"(?i)(ecocash|onemoney|netone|econet|telecel|esolutions|zimswitch|omari|innbucks|callback)\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
