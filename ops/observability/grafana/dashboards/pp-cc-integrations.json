      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "probe_duration_seconds{job=\"provider-connectivity\", module=\"tcp_connect\"}",
          "legendFormat": "{{name}}",
          "refId": "G"
