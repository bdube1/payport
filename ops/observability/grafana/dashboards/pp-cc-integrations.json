    {
      "id": 5,
      "type": "timeseries",
      "title": "Provider response times (connect)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
