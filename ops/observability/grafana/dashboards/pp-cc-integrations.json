    {
      "id": 19,
      "type": "timeseries",
      "title": "Failed integration requests",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (client_name) (rate(http_client_requests_seconds_count{job=\"payport-gateway\", outcome!=\"SUCCESS\"}[5m])) * 60",
          "legendFormat": "{{client_name}}",
          "refId": "U"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"payport-gateway\", uri=~\"/api/v1/callbacks/.*\", status=~\"4..|5..\"}[5m])) * 60",
          "legendFormat": "Callbacks refused per min",
          "refId": "V"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
