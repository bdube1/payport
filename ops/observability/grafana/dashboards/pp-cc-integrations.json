{
  "uid": "pp-cc-integrations",
  "title": "5. Integrations and Providers",
  "tags": [
    "payport",
    "control-centre"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "style": "dark",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Provider API health (real requests)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "max by (provider) (payport_cc_provider_up)",
          "legendFormat": "{{provider}}",
          "refId": "C",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "text": {}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#64748b",
                "value": null
              },
              {
                "color": "#ef4444",
                "value": 0
              },
              {
                "color": "#22c55e",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Operational",
                  "color": "#22c55e"
                },
                "0": {
                  "text": "Down",
                  "color": "#ef4444"
                },
                "-1": {
                  "text": "Not checked",
                  "color": "#64748b"
                }
              }
            }
          ],
          "noValue": "0"
        },
        "overrides": []
      }
    },
