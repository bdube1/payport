    {
      "id": 17,
      "type": "timeseries",
      "title": "Suspicious API activity",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"payport-gateway\", status=~\"401|403\"}[5m])) * 60",
          "legendFormat": "Refused (401/403) per min",
          "refId": "S"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum(increase(payport_security_events_total{event=\"rate_limited\"}[5m]))",
          "legendFormat": "Rate-limited (5 min)",
          "refId": "T"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum(increase(payport_security_events_total{event=\"webhook_signature_invalid\"}[5m]))",
          "legendFormat": "Bad webhook signatures (5 min)",
          "refId": "U"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"payport-gateway\", status=\"404\"}[5m])) * 60",
          "legendFormat": "Not found per min (probing)",
          "refId": "V"
        }
      ],
