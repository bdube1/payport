# Copy to .env (chmod 600). Never commit .env or secrets/.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=https://monitor-staging.payport.africa
# A read-only Grafana login for the TV (created by scripts/setup-tv.sh)
GRAFANA_TV_PASSWORD=
PROMETHEUS_RETENTION=30d
# Where the gateway writes staging.log
PAYPORT_LOG_DIR=/opt/payport/staging
# Kibana profile only
ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
KIBANA_PUBLIC_URL=https://logs-staging.payport.africa
