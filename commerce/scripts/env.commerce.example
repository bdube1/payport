# PayPort Commerce settings (copy to ../.env.commerce, chmod 600). Never commit the filled-in file.
PORT=8086
FORWARD_HEADERS_STRATEGY=native
# Commerce's OWN database and user (see scripts/create-database.sql); never the PSP's.
COMMERCE_DB_URL="jdbc:mysql://127.0.0.1:3306/payport_commerce_staging?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Africa/Harare"
COMMERCE_DB_USERNAME=payport_commerce
COMMERCE_DB_PASSWORD=
# openssl rand -hex 32
COMMERCE_TOKEN_SECRET=
# The same value as PAYPORT_COMMERCE_KEY in the gateway's .env.staging (openssl rand -hex 24)
PAYPORT_COMMERCE_KEY=
PAYPORT_PSP_URL=http://127.0.0.1:8085
COMMERCE_PUBLIC_URL=https://store-staging.payport.africa
COMMERCE_PORTAL_ORIGINS=https://merchant-staging.payport.africa
COMMERCE_CHECKOUT_ORIGIN=https://app-staging.payport.africa
