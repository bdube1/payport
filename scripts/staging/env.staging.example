# PayPort STAGING environment (Phase 11). Copy to /opt/payport/staging/.env.staging, fill in, chmod 600.
# Never commit the filled-in file. Every value below is a NAME only; secrets go in the copy on the server.
# The file is read by bash ("source"): quote any value containing & ; $ * ? [ ] or spaces, in single quotes if it contains $ .
#
# The staging guard (scripts/staging/start-staging.sh) refuses to start unless:
#   PAYPORT_ENV=staging, the database name contains "staging", SETTLEMENT_MODE=PARALLEL,
#   SETTLEMENT_AUTOMATION_ENABLED=false and SERVER_PORT is not the production port (8084).

# ── Deployment ──────────────────────────────────────────────────────────────
PAYPORT_ENV=staging
SERVER_PORT=8085
# base64 of 32 random bytes, different from production:  openssl rand -base64 32
PAYPORT_DATA_KEY=
# Protects /actuator/prometheus (the load-test script reads connection-pool metrics with it): openssl rand -hex 24
PAYPORT_METRICS_TOKEN=
# The staging frontends' origins, comma-separated, e.g. http://68.183.134.5:4001 (http allowed outside production only)
PAYPORT_CORS_EXTRA_ORIGINS=

# ── Database: an ISOLATED copy restored from a backup (scripts/staging/build-staging-db.sh) ──
DB_URL="jdbc:mysql://localhost:3306/gateway_staging?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8"
# Use a staging-only MySQL user with rights on gateway_staging only (the script prints the GRANTs)
DB_USERNAME=payport_staging
DB_PASSWORD=
JWT_SECRET=                       # different from production: openssl rand -base64 48

# ── Money controls: must stay like this in staging ──────────────────────────
SETTLEMENT_MODE=PARALLEL
SETTLEMENT_AUTOMATION_ENABLED=false
TRANSACTION_TOKEN_ENFORCE=false   # set true once the staging frontends send X-Transaction-Token (R81)

# ── Providers: SANDBOX / TEST credentials only ──────────────────────────────
# EcoCash (sandbox)
ECOCASH_MERCHANT_CODE=
ECOCASH_MERCHANT_PIN=
ECOCASH_MERCHANT_NUMBER=
ECOCASH_TERMINAL_ID=
ECOCASH_USERNAME=
ECOCASH_PASSWORD=
# OneMoney (reachable only over the OneMoney VPN from the staging host)
ONEMONEY_BASE_URL=
ONEMONEY_MERCHANT_NO=
ONEMONEY_ENCRYPT_KEY_ID=
ONEMONEY_PLATFORM_PUBLIC_KEY=
ONEMONEY_MERCHANT_PRIVATE_KEY=
# Econet airtime/data XML-RPC (reachable only over the Econet VPN; plain HTTP, see R76)
ECONET_ENDPOINT=
ECONET_PORT=
ECONET_ZWG_USERNAME=
ECONET_ZWG_PASSWORD=
ECONET_USD_USERNAME=
ECONET_USD_PASSWORD=
# e-Solutions (test environment)
ESOLUTIONS_BASE_URL=
ESOLUTIONS_USERNAME=
ESOLUTIONS_PASSWORD=
ESOLUTIONS_VENDOR_NUMBER=
ESOLUTIONS_ACCOUNT_NUMBER=
# Others (not in the first Phase 11 batch; leave as test values or empty)
OMARI_BASE_URL=
OMARI_API_KEY=
OMARI_TEST_MSISDN=
NETONE_ACCESS_CODE=
NETONE_ACCESS_PASSWORD=
TELECEL_AGENT_CODE=
TELECEL_MPIN=
ZIMSWITCH_ENTITY_ID=
ZIMSWITCH_BEARER_TOKEN=
# SMS: Africa's Talking sandbox username makes no real deliveries
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_SENDER_ID=
